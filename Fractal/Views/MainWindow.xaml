<Window x:Class="FractalViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FractalViewer.Converters"
        Title="Fractal Viewer" Height="720" Width="1200"
        Background="{StaticResource BgWindow}">
    <Window.Resources>
        <conv:ColormapToBrushConverter x:Key="ColormapToBrush"/>
        <conv:EqualityToBrushMultiConverter x:Key="EqBrush"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- ВНИМАНИЕ: у Window РОВНО ОДИН дочерний элемент — этот Grid -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: превью + выделение -->
        <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="12" Padding="8" Margin="0,0,16,0">
            <Grid x:Name="PreviewHost">
                <Image x:Name="Preview" Source="{Binding PreviewImage}" Stretch="Uniform"/>
                <TextBlock Text="Нажмите и тяните мышью, чтобы приблизить область"
                           Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                           IsHitTestVisible="False"/>

                <!-- Оверлей выделения -->
                <Canvas x:Name="SelectionCanvas"
                        Background="Transparent"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Rectangle x:Name="SelectionRect" Visibility="Collapsed"
                               Stroke="{StaticResource Accent}" StrokeThickness="2"
                               Fill="#40FFFFFF" RadiusX="6" RadiusY="6"/>
                </Canvas>

                <!-- Полупрозрачная кнопка "Назад" поверх превью -->
                <Button x:Name="BackButton"
        Content="← Назад"
        Command="{Binding BackCommand}"
        Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="6"
        Padding="10,6"
        Cursor="Hand"
        Focusable="False"
        Foreground="{StaticResource TextPrimary}"
        Background="{StaticResource BgCard}"
        BorderBrush="{StaticResource ControlBorder}"
        BorderThickness="1"
        Opacity="0.6">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="0.6"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.95"/>
                                    <Setter Property="Background" Value="{StaticResource ControlHover}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </Grid>
        </Border>

        <!-- ПРАВАЯ ПАНЕЛЬ: параметры -->
        <Border Grid.Column="1" Background="{StaticResource BgCard}" CornerRadius="12" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Фрактал" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding FractalTypes}" SelectedItem="{Binding SelectedFractal}"/>

                    <TextBlock Text="Палитра" FontWeight="SemiBold" Margin="0,16,0,8"/>
                    <ItemsControl ItemsSource="{Binding Colormaps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- цветовая плашка -->
                                <Grid Margin="0,6,0,0">
                                    <!-- фон-градиент -->
                                    <Border CornerRadius="10" Padding="10"
                                            Background="{Binding Converter={StaticResource ColormapToBrush}}"/>

                                    <!-- название поверх (всегда видно) -->
                                    <TextBlock Text="{Binding}" Margin="14,8"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               IsHitTestVisible="False"/>

                                    <!-- РАМКА выделения (НЕ заливка) -->
                                    <Border CornerRadius="10" BorderThickness="3" IsHitTestVisible="False">
                                        <Border.BorderBrush>
                                            <MultiBinding Converter="{StaticResource EqBrush}">
                                                <!-- SelectedColormap из VM -->
                                                <Binding Path="DataContext.SelectedColormap" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <!-- Текущий элемент (строка) -->
                                                <Binding/>
                                            </MultiBinding>
                                        </Border.BorderBrush>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                        <!-- клики по плашкам -->
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <EventSetter Event="MouseLeftButtonUp" Handler="PaletteItem_Click"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>

                    <TextBlock Text="Итерации" FontWeight="SemiBold" Margin="0,16,0,8"/>
                    <TextBox Text="{Binding Iterations, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- тумблер double/decimal -->
                    <CheckBox Content="Использовать decimal (медленнее)"
                              IsChecked="{Binding UseDecimalIterations}"
                              Margin="0,8,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Ширина"/>
                            <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Высота"/>
                            <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Рассчитать" Command="{Binding ApplyCommand}" Margin="0,0,8,0"/>
                        <Button Content="Сброс" Command="{Binding ResetCommand}" Margin="0,0,8,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
